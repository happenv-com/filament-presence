{
    "name": "happenv-com/filament-presence",
    "description": "Live presence avatars and session log for Filament panels.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "filament",
        "presence",
        "reverb",
        "websockets"
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.0 || ^5.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0"
    },
    "suggest": {
        "spatie/laravel-activitylog": "Enables the activitylog presence recorder driver."
    },
    "autoload": {
        "psr-4": {
            "Happenv\\FilamentPresence\\": "src/",
            "Happenv\\FilamentPresence\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Happenv\\FilamentPresence\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Happenv\\FilamentPresence\\FilamentPresenceServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
